# IRIV EdgeAI Studio -- install-time defaults.
#
# Copy this file to .env and change what you need. On an installed box the
# file lives at /etc/irivai/studio.env (install.sh creates it from .env, or
# from this file, the first time) so software updates keep it.
#
# These are the values a box STARTS with. Anything changed later on a page
# (Network, Settings ...) is saved on the box and wins over this file.
# A variable already set in the environment (systemd, the shell) wins too.
# Blank = the built-in default shown in the comment.

# -- Device name ------------------------------------------------------------
# Hostname on the network (<name>.local). Letters, digits and '-'.
IRIV_DEFAULT_HOSTNAME=IRIV-EdgeAI-Studio

# -- Hotspot (AP mode) ------------------------------------------------------
# The device's own address on its hotspot; clients get leases in the same /24.
# If a cable's network uses the same range, the hotspot falls back to 10.42.0.1.
IRIV_AP_ADDRESS=192.168.1.1
# The hotspot password a new or reset box broadcasts (8-63 characters).
IRIV_AP_PASSWORD=iriv1234

# -- Storage ----------------------------------------------------------------
# Where systems, recordings and the database live. Blank = the NVMe if one
# is mounted, else the SD card.
CYTRON_STORE=
CYTRON_NVME=
# Where downloaded / built-in AI models are kept. Blank = the store's default.
CYTRON_MODEL_DIR=
CYTRON_BUILTIN_MODEL_DIR=
